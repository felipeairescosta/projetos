{
  "manifest_version": 3,
  "name": "PJe TRE-CE — Exportar CSV",
  "version": "1.0.0",
  "description": "Exporta resultados de consulta do PJe TRE-CE para CSV",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://pje.tre.ce.gov.br/*",
        "*://pje1g.tre.ce.gov.br/*",
        "*://pje2g.tre.ce.gov.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://pje.tre.ce.gov.br/*",
    "*://pje1g.tre.ce.gov.br/*",
    "*://pje2g.tre.ce.gov.br/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pje-trece-csv@felipeairescosta",
      "strict_min_version": "109.0"
    }
  }
}
