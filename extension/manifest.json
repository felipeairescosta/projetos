{
  "manifest_version": 3,
  "name": "PJe TRE — Exportar CSV",
  "version": "1.1.0",
  "description": "Exporta resultados de consulta do PJe (qualquer TRE) para CSV",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.jus.br/*"],
      "js": ["content_main.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.jus.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["*://*.jus.br/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "pje-tre-csv@felipeairescosta",
      "strict_min_version": "128.0"
    }
  }
}
